APP_NAME=shop-open
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# MySQL 口令：必须与你的 MySQL 实际口令一致。三种情况：
#   ① 用 docker compose.yml 起数据库 → 填 DEV_ONLY_123456（或你自己在 .env.db 里设的值）
#   ② 本地 MySQL 的 root 无密码 → 留空
#   ③ 本地 root 有密码 → 填你的密码
DB_PASSWORD=
DB_NAME=aaashop
# 必填：随机密钥，生成命令 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
# 连接池大小：并发请求多时出现请求卡住可调大 DB_POOL_MAX（不得超过 MySQL 的 max_connections）
DB_POOL_MIN=2
DB_POOL_MAX=10
# 商城会员令牌（可独立于后台密钥；留空则回退 JWT_SECRET）
MEMBER_JWT_SECRET=
# 演示通道短信验证码：true 表示不真实下发、验证码随每次请求随机生成并通过 devCode 回显。
# 置 false 后验证码通道不可用（本项目未内置短信服务商 SDK），注册也随之停用。
SMS_MOCK=true
SMS_CODE_EXPIRE_SECONDS=300
SMS_INTERVAL_SECONDS=60
ORDER_PAY_TIMEOUT_MINUTES=14
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# 上传文件对外可访问前缀；默认留空=按当前请求 host 生成。部署在反向代理/HTTPS 域名后时需显式设置，例如 https://shop.example.com
UPLOAD_PUBLIC_BASE=
GOODS_AUDIT_ENABLED=false
# 跨域来源（逗号分隔）。已包含 localhost 与 127.0.0.1 两种写法，浏览器用哪个打开前台都不会被拦
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://localhost:8000,http://localhost:8001
# 首次执行 python -m seed.runner base 时生成的管理员初始密码。
# 模板刻意留空 → seed 会随机生成并打印到终端（推荐，避免弱口令进入仓库）。
# 若要跑 pytest，这里需显式填一个值：写进 backend/.env 即可生效（无需额外 export），设置后重跑 seed base。
ADMIN_INIT_PASSWORD=
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_LOCK_MINUTES=15
PAGE_SIZE=20
# 后端监听端口（run.py 启动时读取 backend/.env，默认 8001）
PORT=8001
# RELOAD=1 开启 uvicorn 热重载（开发用，watch 子进程僵死后端口被占的概率略高；本地调试期可设 1，生产/验收期保持 0）
RELOAD=0
# 管理端静态目录（可选，默认取 backend 同级目录 manager/，由后端 8001 同源托管）
# 启用时建议填绝对路径：相对路径会随启动目录变化，换目录启动会导致 /manager 404
# STATIC_MANAGER_DIR=../manager
# STATIC_FRONT_DIR=../front（已停用：front 改由 8000 独立静态服务托管，后端不再 mount /front，保留仅兼容）
